{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "RPKI Observatory — Tendencias",
  "description": "Evolución temporal de métricas RPKI. Longitudes en formato 3 dígitos: 008=/8, 024=/24, 048=/48, 128=/128.",
  "uid": "rpki-tendencias",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5m",
  "tags": ["rpki", "tendencias"],
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "hide": 0,
        "label": "Datasource"
      },
      {
        "name": "version",
        "label": "Versión IP",
        "type": "custom",
        "hide": 0,
        "current": { "text": "IPv6", "value": "IPv6" },
        "options": [
          { "text": "IPv4", "value": "IPv4", "selected": false },
          { "text": "IPv6", "value": "IPv6", "selected": true }
        ],
        "query": "IPv4,IPv6"
      },
      {
        "name": "longitud",
        "label": "Longitud (/prefijo)",
        "type": "query",
        "hide": 0,
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(rpki_trend_prefixlen{version=\"$version\"}, longitud)",
        "sort": 1,
        "refresh": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "row",
      "title": "PrefixLen y MaxLength por RIR",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "PrefixLen /$longitud ($version) — ROAs por RIR en el tiempo",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "pointSize": 5, "showPoints": "always", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rpki_trend_prefixlen{version=\"$version\", longitud=\"$longitud\"}",
          "legendFormat": "{{trust_anchor}}",
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "MaxLength /$longitud ($version) — ROAs por RIR en el tiempo",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "pointSize": 5, "showPoints": "always", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rpki_trend_maxlen{version=\"$version\", longitud=\"$longitud\"}",
          "legendFormat": "{{trust_anchor}}",
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Comparación global: PrefixLen vs MaxLength /$longitud ($version)",
      "description": "Suma de todos los RIRs.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "pointSize": 5, "showPoints": "always", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rpki_trend_prefixlen{version=\"$version\", longitud=\"$longitud\"})",
          "legendFormat": "PrefixLen /$longitud (total)",
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rpki_trend_maxlen{version=\"$version\", longitud=\"$longitud\"})",
          "legendFormat": "MaxLength /$longitud (total)",
          "instant": false,
          "refId": "B"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Rutas BGP — Estados RPKI en el tiempo",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rutas inválidas IPv4 por estado — evolución temporal",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "pointSize": 5, "showPoints": "always", "spanNulls": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "valid" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "invalid_origin_mismatch" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "invalid_max_length" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "notfound" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#808080", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rpki_trend_rutas{version=\"IPv4\"}",
          "legendFormat": "{{estado}}",
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rutas inválidas IPv6 por estado — evolución temporal",
